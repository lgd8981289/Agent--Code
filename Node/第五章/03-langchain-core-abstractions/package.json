		"calling": "node --env-file=.env core-abstractions.js calling",
		"runnable": "node --env-file=.env core-abstractions.js runnable",
		"check": "node --check core-abstractions.js"
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"dependencies": {
		"@langchain/core": "1.2.5",
		"@langchain/deepseek": "1.1.6",
		"langchain": "1.5.5",
		"zod": "4.4.3"
	}
}

