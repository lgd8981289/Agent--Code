{
  "name": "python-agent-evaluation-arena-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.20" },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "uv run --locked python -m server.main",
    "dev:web": "vite --config web/vite.config.ts",
    "check": "vue-tsc -p web/tsconfig.json --noEmit",
    "build": "npm run check && vite build --config web/vite.config.ts",
    "test": "uv run --locked python -m unittest discover -s test -v"
  },
  "dependencies": { "vue": "3.5.43", "@lucide/vue": "1.54.0", "zod": "4.6.7" },
  "devDependencies": {
    "@types/node": "^22.20.5", "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.1.5", "typescript": "^5.9.2", "vue-tsc": "^3.0.0", "concurrently": "^9.2.1"
  }
}
