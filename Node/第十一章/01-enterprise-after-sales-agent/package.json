{
  "name": "01-enterprise-after-sales-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "assert-node": "node scripts/assert-node.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "node scripts/wait-for-api.mjs && vite --config web/vite.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "check": "tsc --noEmit && vue-tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-usability.mjs",
    "build": "npm run check && tsc && vite build --config web/vite.config.ts",
    "start": "node dist/server/main.js",
    "predev": "npm run assert-node",
    "predev:server": "npm run assert-node",
    "predev:web": "npm run assert-node",
    "presetup": "npm run assert-node",
    "predoctor": "npm run assert-node",
    "prereset-demo": "npm run assert-node",
    "precheck": "npm run assert-node",
    "pretest": "npm run assert-node",
    "pretest:integration": "npm run assert-node",
    "pretest:browser": "npm run assert-node",
    "prebuild": "npm run assert-node",
    "prestart": "npm run assert-node",
    "knowledge:index": "tsx scripts/index-policies.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run test:integration"
  },
  "dependencies": {
    "@langchain/core": "1.2.14",
    "@langchain/deepseek": "1.1.13",
    "@langchain/langgraph": "1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@lucide/vue": "1.54.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-ws": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "@zilliz/milvus2-sdk-node": "3.0.3",
    "deepagents": "1.14.0",
    "dompurify": "^3.4.17",
    "dotenv": "17.2.2",
    "langchain": "1.5.12",
    "marked": "^18.1.1",
    "openai": "7.32.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vue": "3.5.43",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.5.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.0",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.0"
  }
}
