{
	"name": "03-langchain-core-abstractions",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "LangChain Chat Model、Message、Tool 与 Runnable 核心抽象实验",
	"scripts": {
		"model": "node --env-file=.env core-abstractions.js model",
		"stream": "node --env-file=.env core-abstractions.js stream",
