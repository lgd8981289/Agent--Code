{
  "name": "06-agent-evaluation-arena", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.20" },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "check": "tsc --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "build": "npm run check && vite build --config web/vite.config.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3", "@nestjs/core": "12.1.3", "@nestjs/platform-express": "12.1.3",
    "reflect-metadata": "0.2.2", "rxjs": "7.8.2", "openai": "7.32.0", "zod": "4.6.7",
    "vue": "3.5.43", "@lucide/vue": "1.54.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5", "@types/express": "^5.0.3", "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.1.5", "typescript": "^5.9.2", "tsx": "^4.20.5", "vue-tsc": "^3.0.0", "concurrently": "^9.2.1"
  }
}
